[Unit]
Description=Jarvis (OpenJarvis) personal AI agent
# Never give up restarting (24/7 service).
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=__REPO__/personal/host/run-jarvis.sh
Environment=JARVIS_HOME=%h/.jarvis
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=default.target
