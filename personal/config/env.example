# Jarvis secrets. Copy to ~/.openjarvis/.env and lock it down:
#   cp ~/jarvis/personal/config/env.example ~/.openjarvis/.env && chmod 600 ~/.openjarvis/.env
# Never commit the real file. One KEY=value per line, no quotes needed.

# --- Brain (Phase 2) ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Slack (Phase 6) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# --- Voice (Phase 7) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Microsoft 365 mail (Phase 5) ---
# The client ID is not secret, but keeping it here is fine.
M365_CLIENT_ID=

# --- Optional: require a token for the local API/dashboard ---
# OPENJARVIS_API_KEY=
